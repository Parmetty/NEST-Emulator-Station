{
  "name": "nest",
  "version": "0.2.0",
  "private": true,
  "description": "Nest - a console-style emulator launcher",
  "main": "./out/main/index.js",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "node tools/run.mjs .",
    "start:here": "node tools/run.mjs . --no-sandbox --user-data-dir=.profile",
    "smoke": "node tools/run.mjs . --no-sandbox --user-data-dir=.profile --smoke",
    "shot": "node tools/run.mjs . --no-sandbox --user-data-dir=.profile --shot=shots/app.png",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "build:capture": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-capture.ps1"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
