{
  "id": "swanstation",
  "name": "SwanStation",
  "systems": ["ps1"],
  "kind": "native",
  "detect": {
    "paths": [
      "{engines}/../tools/nest-libretro.exe",
      "{engines}/swanstation/swanstation_libretro.dll"
    ]
  },
  "download": {
    "homepage": "https://github.com/libretro/swanstation"
  },
  "launch": {
    "args": [
      "--core", "{engines}/swanstation/swanstation_libretro.dll",
      "--rom", "{rom}",
      "--system-dir", "{userData}/libretro/sys",
      "--save-dir", "{userData}/libretro/save",
      "--shot-dir", "{userData}/covers-pending",
      "--shot-every", "120",
      "--timeout", "0",
      "--log", "{userData}/libretro/nest-libretro.log"
    ],
    "systemArgs": [
      "--core", "{engines}/swanstation/swanstation_libretro.dll",
      "--system-dir", "{userData}/libretro/sys",
      "--save-dir", "{userData}/libretro/save",
      "--core-option", "swanstation_MemoryCards_Card1Type=None",
      "--timeout", "0",
      "--log", "{userData}/libretro/nest-libretro.log"
    ],
    "cwd": "engineDir"
  },
  "captureAspect": 1.333333,
  "capabilities": {
    "saveStates": true,
    "systemMode": "PS1 系统菜单（BIOS）"
  }
}
