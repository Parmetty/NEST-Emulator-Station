    "cwd": "engineDir"
  },
  "dismissDialog": {
    "title": "Xenia",
    "button": "否",
    "timeout": 15000
  },
  "captureAspect": 1.777777,
  "captureFitWorkArea": true,
  "capabilities": {
    "saveStates": false,
    "systemMode": null
  }
}
