{
  "id": "dolphin",
  "name": "Dolphin",
  "systems": ["ngc", "wii"],
  "kind": "native",
  "detect": {
    "paths": [
      "{engines}/dolphin/Dolphin.exe",
      "%PROGRAMFILES%/Dolphin-x64/Dolphin.exe",
      "%PROGRAMFILES%/Dolphin/Dolphin.exe"
    ]
  },
  "download": {
    "homepage": "https://dolphin-emu.org/download/"
  },
  "systemArgsBySystem": {
    "wii": ["-u", "{userData}/dolphin", "-b", "-e", "{userData}/dolphin/wii-menu.wad"]
  },
  "launch": {
    "args": ["-u", "{userData}/dolphin", "-b", "-e", "{rom}"],
    "systemArgs": ["-u", "{userData}/dolphin"],
    "cwd": "engineDir"
  },
  "systemBoot": {
    "top": "工具",
    "menu": "GameCube",
    "item": "NTSC-U",
    "title": "Dolphin",
    "renderTitle": "JIT64",
    "delay": 3000,
    "minimize": true
  },
  "captureMinHeight": 240,
  "capabilities": {
    "saveStates": true,
    "systemMode": "GameCube Menu"
  }
}
