{
  "id": "cemu",
  "name": "Cemu",
  "systems": ["wiiu"],
  "kind": "native",
  "detect": {
    "paths": [
      "{engines}/cemu/Cemu.exe",
      "%PROGRAMFILES%/Cemu/Cemu.exe",
      "%PROGRAMFILES%/Cemu_2.6/Cemu.exe"
    ]
  },
  "download": {
    "homepage": "https://cemu.info/"
  },
  "launch": {
    "args": ["-g", "{rom}"],
    "systemArgs": ["-t", "0005001010040000"],
    "cwd": "engineDir"
  },
  "systemArgsBySystem": {
    "wiiu": ["-t", "0005001010040000"]
  },
  "fullscreenFlag": "-f",
  "captureAspect": 1.7777778,
  "capabilities": {
    "saveStates": true,
    "systemMode": "Wii U Menu"
  }
}
