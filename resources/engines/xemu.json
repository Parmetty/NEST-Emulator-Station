{
  "id": "xemu",
  "name": "xemu",
  "systems": [
    "xbox"
  ],
  "kind": "native",
  "detect": {
    "paths": [
      "{engines}/xemu/xemu.exe",
      "%PROGRAMFILES%/xemu/xemu.exe"
    ]
  },
  "download": {
    "homepage": "https://xemu.app/"
  },
  "launch": {
    "args": [
      "-dvd_path",
      "{rom}"
    ],
    "systemArgs": [],
    "cwd": "engineDir"
  },
  "captureAspect": 1.333333,
  "capabilities": {
    "saveStates": true,
    "systemMode": null
  }
}
