{
  "id": "mgba",
  "name": "mGBA",
  "systems": ["gba"],
  "kind": "native",
  "detect": {
    "paths": [
      "{engines}/mgba/mGBA.exe",
      "%PROGRAMFILES%/mGBA/mGBA.exe",
      "%LOCALAPPDATA%/mGBA/mGBA.exe"
    ]
  },
  "download": {
    "homepage": "https://mgba.io/downloads.html"
  },
  "launch": {
    "args": ["{rom}"],
    "systemArgs": [],
    "fullscreenFlag": "-f",
    "configFlag": "-C",
    "screenshotPathOption": "screenshotPath",
    "cwd": "engineDir"
  },
  "captureAspect": 1.5,
  "capabilities": {
    "saveStates": true,
    "systemMode": null
  }
}
